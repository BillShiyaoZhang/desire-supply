{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:desire:contracts:config:internal-sandbox-deployment-v1",
  "title": "Desire INTERNAL_SANDBOX deployment configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "deployment_mode",
    "external_participants_enabled",
    "internal_bff_origin",
    "runtime_config_path",
    "secret_manifest_path",
    "secret_root",
    "postgres",
    "oidc",
    "system_actor_id",
    "bind"
  ],
  "properties": {
    "schema_name": {
      "const": "desire-internal-sandbox-deployment-v1"
    },
    "deployment_mode": {
      "const": "INTERNAL_SANDBOX"
    },
    "external_participants_enabled": {
      "const": false
    },
    "internal_bff_origin": {
      "const": "http://api:8000"
    },
    "runtime_config_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "secret_manifest_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "secret_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "database", "transport_security"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "transport_security": {
          "enum": ["TLS_REQUIRED", "TRUSTED_CONTAINER_NETWORK"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport_security": {"const": "TRUSTED_CONTAINER_NETWORK"}
            }
          },
          "then": {
            "properties": {
              "host": {"const": "db"}
            }
          }
        }
      ]
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "client_id",
        "client_secret_key_id",
        "redirect_uri",
        "allowed_signing_algorithms",
        "metadata_ttl_seconds",
        "request_timeout_seconds",
        "maximum_response_bytes",
        "clock_skew_seconds",
        "subject_digest_key_id",
        "network_binding"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "pattern": "^https://[^?#]+[^/?#]$"
        },
        "client_id": {
          "$ref": "#/$defs/opaqueCode"
        },
        "client_secret_key_id": {
          "$ref": "#/$defs/keyId"
        },
        "redirect_uri": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://[^?#]+/v1/auth/oidc/callback$"
        },
        "allowed_signing_algorithms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["ES256", "RS256"]
          }
        },
        "metadata_ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "maximum_response_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 1048576
        },
        "clock_skew_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "subject_digest_key_id": {
          "$ref": "#/$defs/keyId"
        },
        "network_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "pinned_public_ipv4"],
          "properties": {
            "mode": {
              "enum": ["SYSTEM_DNS_SYNTHETIC", "PINNED_PUBLIC_IP"]
            },
            "pinned_public_ipv4": {
              "type": ["string", "null"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {"const": "SYSTEM_DNS_SYNTHETIC"}
                }
              },
              "then": {
                "properties": {
                  "pinned_public_ipv4": {"const": null}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {"const": "PINNED_PUBLIC_IP"}
                }
              },
              "then": {
                "properties": {
                  "pinned_public_ipv4": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 15,
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "system_actor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "const": "0.0.0.0"
        },
        "port": {
          "const": 8000
        }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^/(?!.*(?:^|/)\\.\\.?/)(?!.*//)[A-Za-z0-9._/-]+[A-Za-z0-9._-]$"
    },
    "opaqueCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
    }
  }
}
