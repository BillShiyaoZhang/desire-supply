{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desire-supply.local/contracts/domain/taxonomy-labels-v1.schema.json",
  "title": "Taxonomy labels v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "bundle_id", "family_code", "locale", "labels"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "canonicalization_version": {"type": "string", "const": "taxonomy-labels-json-v1"},
    "bundle_id": {"$ref": "#/$defs/OpaqueId"},
    "family_code": {"$ref": "#/$defs/Code"},
    "locale": {"$ref": "#/$defs/Locale"},
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/Label"}
    }
  },
  "$defs": {
    "OpaqueId": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"},
    "Code": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[A-Z0-9][A-Z0-9_.:-]{1,63}$"},
    "Locale": {"type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"},
    "SafeShortText": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^<>\\u0000-\\u001F\\u007F]*$"},
    "SafeLongText": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^<>\\u0000-\\u001F\\u007F]*$"},
    "NullableLongText": {"oneOf": [{"$ref": "#/$defs/SafeLongText"}, {"type": "null"}]},
    "NullableShortText": {"oneOf": [{"$ref": "#/$defs/SafeShortText"}, {"type": "null"}]},
    "Label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "short_label", "description", "accessibility_label"],
      "properties": {
        "code": {"$ref": "#/$defs/Code"},
        "short_label": {"$ref": "#/$defs/SafeShortText"},
        "description": {"$ref": "#/$defs/NullableLongText"},
        "accessibility_label": {"$ref": "#/$defs/NullableShortText"}
      }
    }
  }
}
