{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.desire.example/domain/trust-report-v1.schema.json",
  "title": "Trust report input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "demand_id",
    "demand_version_id",
    "evidence_reference_ids",
    "impact_codes",
    "incident_ended_at",
    "incident_started_at",
    "requested_protection_codes"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["DATA_EXPOSURE", "FRAUD_RISK", "HARASSMENT", "RETALIATION", "WORKFLOW_INTEGRITY"]
    },
    "demand_id": {"type": "string", "format": "uuid"},
    "demand_version_id": {"type": "string", "format": "uuid"},
    "evidence_reference_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "impact_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["PARTICIPANT_SAFETY_RISK", "RETALIATION_RISK", "SYNTHETIC_DATA_DISCLOSED", "SYNTHETIC_FINANCIAL_RISK", "WORKFLOW_INTEGRITY_RISK"]
      }
    },
    "incident_ended_at": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "incident_started_at": {"type": "string", "format": "date-time"},
    "requested_protection_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["PAUSE_MATCHING", "PAUSE_SUBMISSION", "PAUSE_VERIFICATION"]
      }
    }
  }
}
