{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.desire.example/domain/appeal-application-v1.schema.json",
  "title": "Appeal application draft input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicant_statement",
    "grounds",
    "new_evidence_reference_ids",
    "requested_outcome"
  ],
  "properties": {
    "applicant_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "writeOnly": true
    },
    "grounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "NEW_MATERIAL_EVIDENCE",
          "PROCEDURAL_ERROR",
          "RULE_MISAPPLICATION"
        ]
      }
    },
    "new_evidence_reference_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "requested_outcome": {
      "type": "string",
      "enum": ["MODIFY_MEASURE", "REMOVE_MEASURE", "VACATE_AND_REMAND"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grounds": {"contains": {"const": "NEW_MATERIAL_EVIDENCE"}}
        }
      },
      "then": {
        "properties": {
          "new_evidence_reference_ids": {"minItems": 1}
        }
      }
    }
  ]
}
