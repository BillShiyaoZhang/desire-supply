{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desire-supply.local/contracts/events/iam-v1.schema.json",
  "title": "Desire Supply IAM v1 events",
  "description": "Closed event contract for IAM-01. Payloads contain only opaque identifiers, controlled codes, immutable hashes, statuses, and UTC timestamps. Contact locators, recipient digests, provider claims, capability tokens, session secrets, policy bodies, consent evidence, free-text reasons, IP addresses, and user agents are not representable.",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/OrganizationBootstrappedEvent"},
    {"$ref": "#/$defs/OrganizationActivatedEvent"},
    {"$ref": "#/$defs/OrganizationSuspendedEvent"},
    {"$ref": "#/$defs/OrganizationResumedEvent"},
    {"$ref": "#/$defs/OrganizationClosedEvent"},
    {"$ref": "#/$defs/OrganizationPublicNameChangedEvent"},
    {"$ref": "#/$defs/CreatorAccessInvitationIssuedEvent"},
    {"$ref": "#/$defs/OrganizationAccessInvitationIssuedEvent"},
    {"$ref": "#/$defs/CreatorAccessInvitationAcceptedEvent"},
    {"$ref": "#/$defs/OrganizationAccessInvitationAcceptedEvent"},
    {"$ref": "#/$defs/CreatorAccessInvitationRevokedEvent"},
    {"$ref": "#/$defs/OrganizationAccessInvitationRevokedEvent"},
    {"$ref": "#/$defs/CreatorAccessInvitationExpiredEvent"},
    {"$ref": "#/$defs/OrganizationAccessInvitationExpiredEvent"},
    {"$ref": "#/$defs/CreatorUserEnrollmentStartedEvent"},
    {"$ref": "#/$defs/OrganizationUserEnrollmentStartedEvent"},
    {"$ref": "#/$defs/UserActivatedEvent"},
    {"$ref": "#/$defs/PendingEnrollmentExpiredEvent"},
    {"$ref": "#/$defs/UserSuspendedEvent"},
    {"$ref": "#/$defs/UserResumedEvent"},
    {"$ref": "#/$defs/UserClosedEvent"},
    {"$ref": "#/$defs/UserRoleGrantedEvent"},
    {"$ref": "#/$defs/MembershipActivatedEvent"},
    {"$ref": "#/$defs/MembershipRoleGrantedEvent"},
    {"$ref": "#/$defs/MembershipSuspendedEvent"},
    {"$ref": "#/$defs/MembershipResumedEvent"},
    {"$ref": "#/$defs/MembershipRevokedEvent"},
    {"$ref": "#/$defs/MembershipRolesRevokedEvent"},
    {"$ref": "#/$defs/PolicyAcceptedEvent"},
    {"$ref": "#/$defs/PolicyRequirementsSatisfiedEvent"},
    {"$ref": "#/$defs/PolicyBundlePublishedEvent"},
    {"$ref": "#/$defs/PolicyBundleSupersededEvent"},
    {"$ref": "#/$defs/ConsentGrantedEvent"},
    {"$ref": "#/$defs/ConsentWithdrawnEvent"},
    {"$ref": "#/$defs/SessionRevokedEvent"},
    {"$ref": "#/$defs/SessionsRevokedEvent"}
    ,{"$ref": "#/$defs/PlatformDutyGrantedEvent"}
    ,{"$ref": "#/$defs/PlatformDutyRevokedEvent"}
  ],
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"
    },
    "NullableOpaqueId": {
      "oneOf": [
        {"$ref": "#/$defs/OpaqueId"},
        {"type": "null"}
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "NullableTimestamp": {
      "oneOf": [
        {"$ref": "#/$defs/Timestamp"},
        {"type": "null"}
      ]
    },
    "ContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "AggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "ActorKind": {
      "type": "string",
      "enum": ["USER", "SYSTEM"]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "OrganizationBootstrapped",
        "OrganizationActivated",
        "OrganizationSuspended",
        "OrganizationResumed",
        "OrganizationClosed",
        "OrganizationPublicNameChanged",
        "AccessInvitationIssued",
        "AccessInvitationAccepted",
        "AccessInvitationRevoked",
        "AccessInvitationExpired",
        "UserEnrollmentStarted",
        "UserActivated",
        "PendingEnrollmentExpired",
        "UserSuspended",
        "UserResumed",
        "UserClosed",
        "UserRoleGranted",
        "MembershipActivated",
        "MembershipRoleGranted",
        "MembershipSuspended",
        "MembershipResumed",
        "MembershipRevoked",
        "MembershipRolesRevoked",
        "PolicyAccepted",
        "PolicyRequirementsSatisfied",
        "PolicyBundlePublished",
        "PolicyBundleSuperseded",
        "ConsentGranted",
        "ConsentWithdrawn",
        "SessionRevoked",
        "SessionsRevoked",
        "PlatformDutyGranted",
        "PlatformDutyRevoked"
      ]
    },
    "AggregateType": {
      "type": "string",
      "enum": [
        "User",
        "Organization",
        "AccessInvitation",
        "UserRoleGrant",
        "Membership",
        "MembershipRoleGrant",
        "PolicyAcceptance",
        "PolicyBundle",
        "ConsentGrant",
        "Session",
        "PlatformDutyGrant"
      ]
    },
    "UserStatus": {
      "type": "string",
      "enum": ["PENDING_ENROLLMENT", "ACTIVE", "SUSPENDED", "CLOSED"]
    },
    "OrganizationStatus": {
      "type": "string",
      "enum": ["PENDING_ADMIN", "ACTIVE", "SUSPENDED", "CLOSED"]
    },
    "OrganizationType": {
      "type": "string",
      "enum": ["BUSINESS", "NONPROFIT", "COMMUNITY", "CREATOR_TEAM"]
    },
    "AccessInvitationStatus": {
      "type": "string",
      "enum": ["ISSUED", "ACCEPTED", "REVOKED", "EXPIRED"]
    },
    "AccessInvitationPurpose": {
      "type": "string",
      "enum": ["CREATOR_ENROLLMENT", "ORGANIZATION_MEMBERSHIP"]
    },
    "TargetScope": {
      "type": "string",
      "enum": ["USER", "ORGANIZATION"]
    },
    "TargetRole": {
      "type": "string",
      "enum": ["CREATOR", "ORG_ADMIN", "DEMAND_OWNER"]
    },
    "OrganizationRole": {
      "type": "string",
      "enum": ["ORG_ADMIN", "DEMAND_OWNER"]
    },
    "MembershipStatus": {
      "type": "string",
      "enum": ["ACTIVE", "SUSPENDED", "REVOKED"]
    },
    "PolicyLegalEffect": {
      "type": "string",
      "enum": ["NOTICE_ACKNOWLEDGEMENT", "CONTRACT_ACCEPTANCE", "CONSENT_TEXT"]
    },
    "PolicyBundleStatus": {
      "type": "string",
      "enum": ["ACTIVE", "SUPERSEDED"]
    },
    "ConsentPurpose": {
      "type": "string",
      "enum": [
        "PILOT_RESEARCH",
        "AI_ASSISTED_PROCESSING",
        "DISCLOSE_PROFILE_FIELDS_TO_PARTY"
      ]
    },
    "ConsentScopeType": {
      "type": "string",
      "enum": [
        "PLATFORM_PARTICIPATION",
        "ORGANIZATION",
        "PROJECT",
        "RECIPIENT_DISCLOSURE"
      ]
    },
    "DataCategory": {
      "type": "string",
      "enum": ["PROFILE", "MATCHING", "RESEARCH", "AI_INPUT", "CONTACT", "PROJECT"]
    },
    "ConsentStatus": {
      "type": "string",
      "enum": ["ACTIVE", "WITHDRAWN"]
    },
    "SessionStatus": {
      "type": "string",
      "const": "REVOKED"
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "occurred_at",
        "aggregate_type",
        "aggregate_id",
        "aggregate_version",
        "actor_kind",
        "actor_id",
        "original_actor_id",
        "correlation_id",
        "causation_id",
        "trace_id",
        "organization_id",
        "payload"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/OpaqueId"},
        "event_type": {"$ref": "#/$defs/EventType"},
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "occurred_at": {"$ref": "#/$defs/Timestamp"},
        "aggregate_type": {"$ref": "#/$defs/AggregateType"},
        "aggregate_id": {"$ref": "#/$defs/OpaqueId"},
        "aggregate_version": {"$ref": "#/$defs/AggregateVersion"},
        "actor_kind": {"$ref": "#/$defs/ActorKind"},
        "actor_id": {"$ref": "#/$defs/OpaqueId"},
        "original_actor_id": {"$ref": "#/$defs/NullableOpaqueId"},
        "correlation_id": {"$ref": "#/$defs/OpaqueId"},
        "causation_id": {"$ref": "#/$defs/OpaqueId"},
        "trace_id": {"$ref": "#/$defs/OpaqueId"},
        "organization_id": {"$ref": "#/$defs/NullableOpaqueId"},
        "payload": {
          "type": "object"
        }
      }
    },
    "CreatorInvitationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invitation_id",
        "bound_invitation_version",
        "issued_policy_bundle_id",
        "purpose",
        "target_scope",
        "target_role",
        "is_initial_admin"
      ],
      "properties": {
        "invitation_id": {"$ref": "#/$defs/OpaqueId"},
        "bound_invitation_version": {"$ref": "#/$defs/AggregateVersion"},
        "issued_policy_bundle_id": {"$ref": "#/$defs/OpaqueId"},
        "purpose": {
          "type": "string",
          "const": "CREATOR_ENROLLMENT"
        },
        "target_scope": {
          "type": "string",
          "const": "USER"
        },
        "target_role": {
          "type": "string",
          "const": "CREATOR"
        },
        "is_initial_admin": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "OrganizationInvitationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invitation_id",
        "bound_invitation_version",
        "issued_policy_bundle_id",
        "purpose",
        "target_scope",
        "target_role",
        "is_initial_admin"
      ],
      "properties": {
        "invitation_id": {"$ref": "#/$defs/OpaqueId"},
        "bound_invitation_version": {"$ref": "#/$defs/AggregateVersion"},
        "issued_policy_bundle_id": {"$ref": "#/$defs/OpaqueId"},
        "purpose": {
          "type": "string",
          "const": "ORGANIZATION_MEMBERSHIP"
        },
        "target_scope": {
          "type": "string",
          "const": "ORGANIZATION"
        },
        "target_role": {"$ref": "#/$defs/OrganizationRole"},
        "is_initial_admin": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "is_initial_admin": {"const": true}
            },
            "required": ["is_initial_admin"]
          },
          "then": {
            "properties": {
              "target_role": {"const": "ORG_ADMIN"}
            }
          }
        }
      ]
    },
    "UserRoleActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "user_role_grant_id"],
      "properties": {
        "kind": {
          "type": "string",
          "const": "USER_ROLE"
        },
        "user_role_grant_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "OrganizationMembershipActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "membership_id", "membership_role_grant_id"],
      "properties": {
        "kind": {
          "type": "string",
          "const": "ORGANIZATION_MEMBERSHIP"
        },
        "membership_id": {"$ref": "#/$defs/OpaqueId"},
        "membership_role_grant_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "CreatorInvitationIssuedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invitation_binding", "status", "expires_at"],
      "properties": {
        "invitation_binding": {"$ref": "#/$defs/CreatorInvitationBinding"},
        "status": {
          "type": "string",
          "const": "ISSUED"
        },
        "expires_at": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "OrganizationInvitationIssuedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invitation_binding", "status", "expires_at"],
      "properties": {
        "invitation_binding": {"$ref": "#/$defs/OrganizationInvitationBinding"},
        "status": {
          "type": "string",
          "const": "ISSUED"
        },
        "expires_at": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "CreatorInvitationAcceptedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invitation_binding", "status", "accepted_user_id", "activation"],
      "properties": {
        "invitation_binding": {"$ref": "#/$defs/CreatorInvitationBinding"},
        "status": {
          "type": "string",
          "const": "ACCEPTED"
        },
        "accepted_user_id": {"$ref": "#/$defs/OpaqueId"},
        "activation": {"$ref": "#/$defs/UserRoleActivation"}
      }
    },
    "OrganizationInvitationAcceptedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invitation_binding", "status", "accepted_user_id", "activation"],
      "properties": {
        "invitation_binding": {"$ref": "#/$defs/OrganizationInvitationBinding"},
        "status": {
          "type": "string",
          "const": "ACCEPTED"
        },
        "accepted_user_id": {"$ref": "#/$defs/OpaqueId"},
        "activation": {"$ref": "#/$defs/OrganizationMembershipActivation"}
      }
    },
    "CreatorInvitationTerminalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invitation_binding", "status"],
      "properties": {
        "invitation_binding": {"$ref": "#/$defs/CreatorInvitationBinding"},
        "status": {
          "type": "string",
          "enum": ["REVOKED", "EXPIRED"]
        }
      }
    },
    "OrganizationInvitationTerminalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invitation_binding", "status"],
      "properties": {
        "invitation_binding": {"$ref": "#/$defs/OrganizationInvitationBinding"},
        "status": {
          "type": "string",
          "enum": ["REVOKED", "EXPIRED"]
        }
      }
    },
    "OrganizationBootstrappedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "organization_type", "status", "initial_admin_invitation_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/OpaqueId"},
        "organization_type": {"$ref": "#/$defs/OrganizationType"},
        "status": {
          "type": "string",
          "const": "PENDING_ADMIN"
        },
        "initial_admin_invitation_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "OrganizationActivatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "status", "access_invitation_id", "initial_admin_membership_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {
          "type": "string",
          "const": "ACTIVE"
        },
        "access_invitation_id": {"$ref": "#/$defs/OpaqueId"},
        "initial_admin_membership_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "OrganizationStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "status"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {"$ref": "#/$defs/OrganizationStatus"}
      }
    },
    "OrganizationPublicNameChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "CreatorUserEnrollmentStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "status", "invitation_binding"],
      "properties": {
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {
          "type": "string",
          "const": "PENDING_ENROLLMENT"
        },
        "invitation_binding": {"$ref": "#/$defs/CreatorInvitationBinding"}
      }
    },
    "OrganizationUserEnrollmentStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "status", "invitation_binding"],
      "properties": {
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {
          "type": "string",
          "const": "PENDING_ENROLLMENT"
        },
        "invitation_binding": {"$ref": "#/$defs/OrganizationInvitationBinding"}
      }
    },
    "UserActivatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "status", "access_invitation_id"],
      "properties": {
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {
          "type": "string",
          "const": "ACTIVE"
        },
        "access_invitation_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "UserStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "status"],
      "properties": {
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {"$ref": "#/$defs/UserStatus"}
      }
    },
    "PlatformDutyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "user_id", "duty_code", "status"],
      "properties": {
        "grant_id": {"$ref": "#/$defs/OpaqueId"},
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "duty_code": {
          "type": "string",
          "enum": [
            "ACCESS_ADMIN",
            "OPERATIONS_REVIEWER",
            "FINANCE_OPERATOR",
            "TRUST_OFFICER",
            "APPEAL_REVIEWER"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "REVOKED"]
        }
      }
    },
    "UserRoleGrantedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_role_grant_id", "user_id", "target_role", "access_invitation_id"],
      "properties": {
        "user_role_grant_id": {"$ref": "#/$defs/OpaqueId"},
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "target_role": {
          "type": "string",
          "const": "CREATOR"
        },
        "access_invitation_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "MembershipActivatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["membership_id", "user_id", "status", "access_invitation_id"],
      "properties": {
        "membership_id": {"$ref": "#/$defs/OpaqueId"},
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {
          "type": "string",
          "const": "ACTIVE"
        },
        "access_invitation_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "MembershipRoleGrantedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_role_grant_id",
        "membership_id",
        "user_id",
        "target_role",
        "access_invitation_id"
      ],
      "properties": {
        "membership_role_grant_id": {"$ref": "#/$defs/OpaqueId"},
        "membership_id": {"$ref": "#/$defs/OpaqueId"},
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "target_role": {"$ref": "#/$defs/OrganizationRole"},
        "access_invitation_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "MembershipStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["membership_id", "user_id", "status"],
      "properties": {
        "membership_id": {"$ref": "#/$defs/OpaqueId"},
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {"$ref": "#/$defs/MembershipStatus"}
      }
    },
    "MembershipRolesRevokedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["membership_id", "user_id", "membership_role_grant_id", "target_role"],
      "properties": {
        "membership_id": {"$ref": "#/$defs/OpaqueId"},
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "membership_role_grant_id": {"$ref": "#/$defs/OpaqueId"},
        "target_role": {"$ref": "#/$defs/OrganizationRole"}
      }
    },
    "PolicyAcceptedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_acceptance_id",
        "user_id",
        "policy_bundle_id",
        "policy_document_id",
        "policy_document_sha256",
        "legal_effect"
      ],
      "properties": {
        "policy_acceptance_id": {"$ref": "#/$defs/OpaqueId"},
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "policy_bundle_id": {"$ref": "#/$defs/OpaqueId"},
        "policy_document_id": {"$ref": "#/$defs/OpaqueId"},
        "policy_document_sha256": {"$ref": "#/$defs/ContentSha256"},
        "legal_effect": {"$ref": "#/$defs/PolicyLegalEffect"}
      }
    },
    "PolicyRequirementsSatisfiedPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Coarse User authorization-gate and read-model invalidation only. Consumers must re-read authoritative policy requirements and must not grant a role or scoped authority from this event alone.",
      "required": ["user_id", "policy_bundle_id"],
      "properties": {
        "user_id": {"$ref": "#/$defs/OpaqueId"},
        "policy_bundle_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "PolicyBundlePublishedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_bundle_id",
        "status",
        "effective_at",
        "superseded_policy_bundle_id",
        "policy_document_ids",
        "consent_offer_ids"
      ],
      "properties": {
        "policy_bundle_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {
          "type": "string",
          "const": "ACTIVE"
        },
        "effective_at": {"$ref": "#/$defs/Timestamp"},
        "superseded_policy_bundle_id": {"$ref": "#/$defs/NullableOpaqueId"},
        "policy_document_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/OpaqueId"}
        },
        "consent_offer_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/OpaqueId"}
        }
      }
    },
    "PolicyBundleSupersededPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_bundle_id", "status", "superseded_by_policy_bundle_id"],
      "properties": {
        "policy_bundle_id": {"$ref": "#/$defs/OpaqueId"},
        "status": {
          "type": "string",
          "const": "SUPERSEDED"
        },
        "superseded_by_policy_bundle_id": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "DerivedConsentAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent_offer_id",
        "consent_offer_version",
        "policy_bundle_id",
        "purpose",
        "scope_type",
        "scope_id",
        "data_categories",
        "supporting_policy_document_id",
        "supporting_document_sha256",
        "expires_at"
      ],
      "properties": {
        "consent_offer_id": {"$ref": "#/$defs/OpaqueId"},
        "consent_offer_version": {"$ref": "#/$defs/AggregateVersion"},
