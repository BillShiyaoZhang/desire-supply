{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desire-supply.local/contracts/events/matching-v1.schema.json",
  "title": "Desire Supply Matching v1 events",
  "description": "Closed minimal matching events. Demand/Profile content, money, scores, ranks, filter evidence, notes, private floors, assignment and receipt secrets are not representable.",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/MatchingAttemptOpenedEvent"},
    {"$ref": "#/$defs/MatchRunQueuedEvent"},
    {"$ref": "#/$defs/MatchRunStartedEvent"},
    {"$ref": "#/$defs/MatchRunCompletedEvent"},
    {"$ref": "#/$defs/MatchRunFailedEvent"},
    {"$ref": "#/$defs/MatchRunFailedBeforeStartEvent"},
    {"$ref": "#/$defs/MatchRunSupersededEvent"},
    {"$ref": "#/$defs/InvitationCreatedEvent"},
    {"$ref": "#/$defs/InvitationSentEvent"},
    {"$ref": "#/$defs/InvitationAcceptedEvent"},
    {"$ref": "#/$defs/InvitationDeclinedEvent"},
    {"$ref": "#/$defs/InvitationWithdrawnEvent"},
    {"$ref": "#/$defs/InvitationRevokedEvent"},
    {"$ref": "#/$defs/InvitationExpiredEvent"},
    {"$ref": "#/$defs/SelectionOpenedEvent"},
    {"$ref": "#/$defs/SelectionInvitationSetChangedEvent"},
    {"$ref": "#/$defs/SelectionIntentRecordedEvent"},
    {"$ref": "#/$defs/SelectionCloseIntentRecordedEvent"},
    {"$ref": "#/$defs/SelectionMadeEvent"},
    {"$ref": "#/$defs/SelectionClosedWithoutChoiceEvent"},
    {"$ref": "#/$defs/SelectionCancelledEvent"},
    {"$ref": "#/$defs/MatchingAttemptSelectedEvent"},
    {"$ref": "#/$defs/MatchingAttemptClosedWithoutSelectionEvent"},
    {"$ref": "#/$defs/MatchingAttemptInvalidatedEvent"},
    {"$ref": "#/$defs/MatchingAttemptCancelledEvent"},
    {"$ref": "#/$defs/CandidateSelectorAssignedEvent"},
    {"$ref": "#/$defs/MatchingRulePublishedEvent"},
    {"$ref": "#/$defs/MatchJobClaimedEvent"},
    {"$ref": "#/$defs/MatchRunRetryScheduledEvent"},
    {"$ref": "#/$defs/SelectionCompletionClaimedEvent"},
    {"$ref": "#/$defs/SelectionCompletionFailedEvent"},
    {"$ref": "#/$defs/SelectionCompletionRetryScheduledEvent"},
    {"$ref": "#/$defs/MatchingReviewAssignmentClaimedEvent"},
    {"$ref": "#/$defs/MatchingReviewAssignmentReleasedEvent"}
  ],
  "$defs": {
    "OpaqueId": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"},
    "NullableOpaqueId": {"oneOf": [{"$ref": "#/$defs/OpaqueId"}, {"type": "null"}]},
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "Version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "Count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "Code": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "EventType": {"type": "string", "enum": ["MatchingAttemptOpened", "MatchRunQueued", "MatchRunStarted", "MatchRunCompleted", "MatchRunFailed", "MatchRunFailedBeforeStart", "MatchRunSuperseded", "InvitationCreated", "InvitationSent", "InvitationAccepted", "InvitationDeclined", "InvitationWithdrawn", "InvitationRevoked", "InvitationExpired", "SelectionOpened", "SelectionInvitationSetChanged", "SelectionIntentRecorded", "SelectionCloseIntentRecorded", "SelectionMade", "SelectionClosedWithoutChoice", "SelectionCancelled", "MatchingAttemptSelected", "MatchingAttemptClosedWithoutSelection", "MatchingAttemptInvalidated", "MatchingAttemptCancelled", "CandidateSelectorAssigned", "MatchingRulePublished", "MatchJobClaimed", "MatchRunRetryScheduled", "SelectionCompletionClaimed", "SelectionCompletionFailed", "SelectionCompletionRetryScheduled", "MatchingReviewAssignmentClaimed", "MatchingReviewAssignmentReleased"]},
    "Envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "event_type", "schema_version", "occurred_at", "aggregate_type", "aggregate_id", "aggregate_version", "actor_kind", "actor_id", "original_actor_id", "organization_id", "correlation_id", "causation_id", "trace_id", "payload"],
      "properties": {
        "event_id": {"$ref": "#/$defs/OpaqueId"}, "event_type": {"$ref": "#/$defs/EventType"}, "schema_version": {"type": "integer", "const": 1}, "occurred_at": {"$ref": "#/$defs/Timestamp"},
        "aggregate_type": {"type": "string", "enum": ["MatchingAttempt", "MatchRun", "Invitation", "Selection", "CandidateSelectorAssignment", "MatchingRule", "MatchJob", "SelectionCompletionJob", "MatchingReviewAssignment"]}, "aggregate_id": {"$ref": "#/$defs/OpaqueId"}, "aggregate_version": {"$ref": "#/$defs/Version"},
        "actor_kind": {"type": "string", "enum": ["USER", "SYSTEM"]}, "actor_id": {"$ref": "#/$defs/OpaqueId"}, "original_actor_id": {"$ref": "#/$defs/NullableOpaqueId"}, "organization_id": {"$ref": "#/$defs/OpaqueId"},
        "correlation_id": {"$ref": "#/$defs/OpaqueId"}, "causation_id": {"$ref": "#/$defs/OpaqueId"}, "trace_id": {"$ref": "#/$defs/OpaqueId"}, "payload": {}
      }
    },
    "AttemptPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "demand_id", "demand_version_id", "matching_request_id", "attempt_no", "status", "reason_code", "selection_id", "chosen_invitation_id"],
      "properties": {"attempt_id": {"$ref": "#/$defs/OpaqueId"}, "demand_id": {"$ref": "#/$defs/OpaqueId"}, "demand_version_id": {"$ref": "#/$defs/OpaqueId"}, "matching_request_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_no": {"$ref": "#/$defs/Version"}, "status": {"type": "string", "enum": ["OPEN", "SELECTED", "CLOSED_NO_SELECTION", "INVALIDATED", "CANCELLED"]}, "reason_code": {"oneOf": [{"$ref": "#/$defs/Code"}, {"type": "null"}]}, "selection_id": {"$ref": "#/$defs/NullableOpaqueId"}, "chosen_invitation_id": {"$ref": "#/$defs/NullableOpaqueId"}}
    },
    "RunPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "attempt_id", "run_no", "rule_bundle_id", "input_set_sha256", "status", "candidate_count", "eligible_count", "excluded_count", "ordered_result_sha256", "failure_code", "successor_run_id"],
      "properties": {"run_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_id": {"$ref": "#/$defs/OpaqueId"}, "run_no": {"$ref": "#/$defs/Version"}, "rule_bundle_id": {"$ref": "#/$defs/OpaqueId"}, "input_set_sha256": {"$ref": "#/$defs/Sha256"}, "status": {"type": "string", "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "SUPERSEDED"]}, "candidate_count": {"oneOf": [{"$ref": "#/$defs/Count"}, {"type": "null"}]}, "eligible_count": {"oneOf": [{"$ref": "#/$defs/Count"}, {"type": "null"}]}, "excluded_count": {"oneOf": [{"$ref": "#/$defs/Count"}, {"type": "null"}]}, "ordered_result_sha256": {"oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]}, "failure_code": {"oneOf": [{"$ref": "#/$defs/Code"}, {"type": "null"}]}, "successor_run_id": {"$ref": "#/$defs/NullableOpaqueId"}}
    },
    "InvitationPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["invitation_id", "attempt_id", "run_id", "creator_user_id", "profile_version_id", "snapshot_sha256", "status", "expires_at", "reason_code"],
      "properties": {"invitation_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_id": {"$ref": "#/$defs/OpaqueId"}, "run_id": {"$ref": "#/$defs/OpaqueId"}, "creator_user_id": {"$ref": "#/$defs/OpaqueId"}, "profile_version_id": {"$ref": "#/$defs/OpaqueId"}, "snapshot_sha256": {"$ref": "#/$defs/Sha256"}, "status": {"type": "string", "enum": ["CREATED", "SENT", "ACCEPTED", "DECLINED", "WITHDRAWN", "REVOKED", "EXPIRED"]}, "expires_at": {"$ref": "#/$defs/Timestamp"}, "reason_code": {"oneOf": [{"$ref": "#/$defs/Code"}, {"type": "null"}]}}
    },
    "SelectionPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_id", "attempt_id", "status", "current_invitation_set_sha256", "chosen_invitation_id", "selection_basis_code", "reason_code"],
      "properties": {"selection_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_id": {"$ref": "#/$defs/OpaqueId"}, "status": {"type": "string", "enum": ["OPEN", "PENDING_CHOICE", "PENDING_CLOSE", "SELECTED", "CLOSED_NO_SELECTION", "CANCELLED"]}, "current_invitation_set_sha256": {"$ref": "#/$defs/Sha256"}, "chosen_invitation_id": {"$ref": "#/$defs/NullableOpaqueId"}, "selection_basis_code": {"oneOf": [{"$ref": "#/$defs/Code"}, {"type": "null"}]}, "reason_code": {"oneOf": [{"$ref": "#/$defs/Code"}, {"type": "null"}]}}
    },
    "CandidateSelectorAssignmentPayload": {"type": "object", "additionalProperties": false, "required": ["assignment_id", "selection_id", "demand_id", "status"], "properties": {"assignment_id": {"$ref": "#/$defs/OpaqueId"}, "selection_id": {"$ref": "#/$defs/OpaqueId"}, "demand_id": {"$ref": "#/$defs/OpaqueId"}, "status": {"const": "ACTIVE"}}},
    "MatchingRulePublishedPayload": {"type": "object", "additionalProperties": false, "required": ["rule_bundle_id", "selector_digest", "status"], "properties": {"rule_bundle_id": {"$ref": "#/$defs/OpaqueId"}, "selector_digest": {"$ref": "#/$defs/Sha256"}, "status": {"const": "ACTIVE"}}},
    "MatchJobClaimedPayload": {"type": "object", "additionalProperties": false, "required": ["job_id", "attempt_id", "match_run_id", "status", "fencing_generation", "recovery_status"], "properties": {"job_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_id": {"$ref": "#/$defs/OpaqueId"}, "match_run_id": {"$ref": "#/$defs/OpaqueId"}, "status": {"const": "LEASED"}, "fencing_generation": {"$ref": "#/$defs/Version"}, "recovery_status": {"type": "string", "enum": ["CLAIMED", "QUEUED_LEASE_RECOVERED"]}}},
    "MatchRunRetryScheduledPayload": {"type": "object", "additionalProperties": false, "required": ["failed_run_id", "failed_run_version", "successor_run_id", "successor_job_id", "attempt_id", "failure_code", "status"], "properties": {"failed_run_id": {"$ref": "#/$defs/OpaqueId"}, "failed_run_version": {"$ref": "#/$defs/Version"}, "successor_run_id": {"$ref": "#/$defs/OpaqueId"}, "successor_job_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_id": {"$ref": "#/$defs/OpaqueId"}, "failure_code": {"$ref": "#/$defs/Code"}, "status": {"const": "QUEUED"}}},
    "MatchRunFailedBeforeStartPayload": {"type": "object", "additionalProperties": false, "required": ["run_id", "attempt_id", "run_no", "rule_bundle_id", "status", "failure_code"], "properties": {"run_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_id": {"$ref": "#/$defs/OpaqueId"}, "run_no": {"$ref": "#/$defs/Version"}, "rule_bundle_id": {"$ref": "#/$defs/OpaqueId"}, "status": {"const": "FAILED"}, "failure_code": {"const": "WORKER_CLAIM_RETRY_EXHAUSTED"}}},
    "SelectionCompletionPayload": {"type": "object", "additionalProperties": false, "required": ["completion_job_id", "selection_id", "intent_kind", "status", "fencing_generation", "attempt_count", "failure_code"], "properties": {"completion_job_id": {"$ref": "#/$defs/OpaqueId"}, "selection_id": {"$ref": "#/$defs/OpaqueId"}, "intent_kind": {"type": "string", "enum": ["CHOOSE", "CLOSE", "SYSTEM_CLOSE"]}, "status": {"type": "string", "enum": ["LEASED", "AVAILABLE", "FAILED"]}, "fencing_generation": {"$ref": "#/$defs/Version"}, "attempt_count": {"type": "integer", "minimum": 1, "maximum": 3}, "failure_code": {"oneOf": [{"$ref": "#/$defs/Code"}, {"type": "null"}]}}},
    "MatchingReviewAssignmentPayload": {"type": "object", "additionalProperties": false, "required": ["assignment_id", "attempt_id", "match_run_id", "purpose_code", "status", "assignment_version"], "properties": {"assignment_id": {"$ref": "#/$defs/OpaqueId"}, "attempt_id": {"$ref": "#/$defs/OpaqueId"}, "match_run_id": {"$ref": "#/$defs/OpaqueId"}, "purpose_code": {"type": "string", "enum": ["MATCH_RETRY", "INVITATION_REVIEW", "ATTEMPT_REVIEW"]}, "status": {"type": "string", "enum": ["ACTIVE", "REVOKED"]}, "assignment_version": {"$ref": "#/$defs/Version"}}},
    "MatchingAttemptOpenedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchingAttemptOpened"}, "aggregate_type": {"const": "MatchingAttempt"}, "payload": {"allOf": [{"$ref": "#/$defs/AttemptPayload"}, {"properties": {"status": {"const": "OPEN"}, "reason_code": {"type": "null"}, "selection_id": {"type": "null"}, "chosen_invitation_id": {"type": "null"}}}]}}}]},
    "MatchRunQueuedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchRunQueued"}, "aggregate_type": {"const": "MatchRun"}, "payload": {"allOf": [{"$ref": "#/$defs/RunPayload"}, {"properties": {"status": {"const": "QUEUED"}, "candidate_count": {"type": "null"}, "eligible_count": {"type": "null"}, "excluded_count": {"type": "null"}, "ordered_result_sha256": {"type": "null"}, "failure_code": {"type": "null"}, "successor_run_id": {"type": "null"}}}]}}}]},
    "MatchRunStartedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchRunStarted"}, "aggregate_type": {"const": "MatchRun"}, "payload": {"allOf": [{"$ref": "#/$defs/RunPayload"}, {"properties": {"status": {"const": "RUNNING"}, "candidate_count": {"type": "null"}, "eligible_count": {"type": "null"}, "excluded_count": {"type": "null"}, "ordered_result_sha256": {"type": "null"}, "failure_code": {"type": "null"}, "successor_run_id": {"type": "null"}}}]}}}]},
    "MatchRunCompletedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchRunCompleted"}, "aggregate_type": {"const": "MatchRun"}, "payload": {"allOf": [{"$ref": "#/$defs/RunPayload"}, {"properties": {"status": {"const": "COMPLETED"}, "candidate_count": {"$ref": "#/$defs/Count"}, "eligible_count": {"$ref": "#/$defs/Count"}, "excluded_count": {"$ref": "#/$defs/Count"}, "ordered_result_sha256": {"$ref": "#/$defs/Sha256"}, "failure_code": {"type": "null"}, "successor_run_id": {"type": "null"}}}]}}}]},
    "MatchRunFailedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchRunFailed"}, "aggregate_type": {"const": "MatchRun"}, "payload": {"allOf": [{"$ref": "#/$defs/RunPayload"}, {"properties": {"status": {"const": "FAILED"}, "candidate_count": {"type": "null"}, "eligible_count": {"type": "null"}, "excluded_count": {"type": "null"}, "ordered_result_sha256": {"type": "null"}, "failure_code": {"$ref": "#/$defs/Code"}, "successor_run_id": {"type": "null"}}}]}}}]},
    "MatchRunFailedBeforeStartEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchRunFailedBeforeStart"}, "aggregate_type": {"const": "MatchRun"}, "payload": {"$ref": "#/$defs/MatchRunFailedBeforeStartPayload"}}}]},
    "MatchRunSupersededEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchRunSuperseded"}, "aggregate_type": {"const": "MatchRun"}, "payload": {"allOf": [{"$ref": "#/$defs/RunPayload"}, {"properties": {"status": {"const": "SUPERSEDED"}, "successor_run_id": {"$ref": "#/$defs/OpaqueId"}}}]}}}]},
    "InvitationCreatedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "InvitationCreated"}, "aggregate_type": {"const": "Invitation"}, "payload": {"allOf": [{"$ref": "#/$defs/InvitationPayload"}, {"properties": {"status": {"const": "CREATED"}, "reason_code": {"type": "null"}}}]}}}]},
    "InvitationSentEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "InvitationSent"}, "aggregate_type": {"const": "Invitation"}, "payload": {"allOf": [{"$ref": "#/$defs/InvitationPayload"}, {"properties": {"status": {"const": "SENT"}, "reason_code": {"type": "null"}}}]}}}]},
    "InvitationAcceptedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "InvitationAccepted"}, "aggregate_type": {"const": "Invitation"}, "payload": {"allOf": [{"$ref": "#/$defs/InvitationPayload"}, {"properties": {"status": {"const": "ACCEPTED"}, "reason_code": {"type": "null"}}}]}}}]},
    "InvitationDeclinedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "InvitationDeclined"}, "aggregate_type": {"const": "Invitation"}, "payload": {"allOf": [{"$ref": "#/$defs/InvitationPayload"}, {"properties": {"status": {"const": "DECLINED"}, "reason_code": {"$ref": "#/$defs/Code"}}}]}}}]},
    "InvitationWithdrawnEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "InvitationWithdrawn"}, "aggregate_type": {"const": "Invitation"}, "payload": {"allOf": [{"$ref": "#/$defs/InvitationPayload"}, {"properties": {"status": {"const": "WITHDRAWN"}, "reason_code": {"$ref": "#/$defs/Code"}}}]}}}]},
    "InvitationRevokedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "InvitationRevoked"}, "aggregate_type": {"const": "Invitation"}, "payload": {"allOf": [{"$ref": "#/$defs/InvitationPayload"}, {"properties": {"status": {"const": "REVOKED"}, "reason_code": {"$ref": "#/$defs/Code"}}}]}}}]},
    "InvitationExpiredEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "InvitationExpired"}, "aggregate_type": {"const": "Invitation"}, "payload": {"allOf": [{"$ref": "#/$defs/InvitationPayload"}, {"properties": {"status": {"const": "EXPIRED"}, "reason_code": {"$ref": "#/$defs/Code"}}}]}}}]},
    "SelectionOpenedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "SelectionOpened"}, "aggregate_type": {"const": "Selection"}, "payload": {"allOf": [{"$ref": "#/$defs/SelectionPayload"}, {"properties": {"status": {"const": "OPEN"}, "chosen_invitation_id": {"type": "null"}, "selection_basis_code": {"type": "null"}, "reason_code": {"type": "null"}}}]}}}]},
    "SelectionInvitationSetChangedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "SelectionInvitationSetChanged"}, "aggregate_type": {"const": "Selection"}, "payload": {"allOf": [{"$ref": "#/$defs/SelectionPayload"}, {"properties": {"status": {"const": "OPEN"}, "chosen_invitation_id": {"type": "null"}, "selection_basis_code": {"type": "null"}, "reason_code": {"type": "null"}}}]}}}]},
    "SelectionIntentRecordedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "SelectionIntentRecorded"}, "aggregate_type": {"const": "Selection"}, "payload": {"allOf": [{"$ref": "#/$defs/SelectionPayload"}, {"properties": {"status": {"const": "PENDING_CHOICE"}, "chosen_invitation_id": {"$ref": "#/$defs/OpaqueId"}, "selection_basis_code": {"$ref": "#/$defs/Code"}, "reason_code": {"type": "null"}}}]}}}]},
    "SelectionCloseIntentRecordedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "SelectionCloseIntentRecorded"}, "aggregate_type": {"const": "Selection"}, "payload": {"allOf": [{"$ref": "#/$defs/SelectionPayload"}, {"properties": {"status": {"const": "PENDING_CLOSE"}, "chosen_invitation_id": {"type": "null"}, "selection_basis_code": {"type": "null"}, "reason_code": {"$ref": "#/$defs/Code"}}}]}}}]},
    "SelectionMadeEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "SelectionMade"}, "aggregate_type": {"const": "Selection"}, "payload": {"allOf": [{"$ref": "#/$defs/SelectionPayload"}, {"properties": {"status": {"const": "SELECTED"}, "chosen_invitation_id": {"$ref": "#/$defs/OpaqueId"}, "selection_basis_code": {"$ref": "#/$defs/Code"}, "reason_code": {"type": "null"}}}]}}}]},
    "SelectionClosedWithoutChoiceEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "SelectionClosedWithoutChoice"}, "aggregate_type": {"const": "Selection"}, "payload": {"allOf": [{"$ref": "#/$defs/SelectionPayload"}, {"properties": {"status": {"const": "CLOSED_NO_SELECTION"}, "chosen_invitation_id": {"type": "null"}, "selection_basis_code": {"type": "null"}, "reason_code": {"$ref": "#/$defs/Code"}}}]}}}]},
    "SelectionCancelledEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "SelectionCancelled"}, "aggregate_type": {"const": "Selection"}, "payload": {"allOf": [{"$ref": "#/$defs/SelectionPayload"}, {"properties": {"status": {"const": "CANCELLED"}, "chosen_invitation_id": {"type": "null"}, "selection_basis_code": {"type": "null"}, "reason_code": {"$ref": "#/$defs/Code"}}}]}}}]},
    "MatchingAttemptSelectedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchingAttemptSelected"}, "aggregate_type": {"const": "MatchingAttempt"}, "payload": {"allOf": [{"$ref": "#/$defs/AttemptPayload"}, {"properties": {"status": {"const": "SELECTED"}, "reason_code": {"type": "null"}, "selection_id": {"$ref": "#/$defs/OpaqueId"}, "chosen_invitation_id": {"$ref": "#/$defs/OpaqueId"}}}]}}}]},
    "MatchingAttemptClosedWithoutSelectionEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchingAttemptClosedWithoutSelection"}, "aggregate_type": {"const": "MatchingAttempt"}, "payload": {"allOf": [{"$ref": "#/$defs/AttemptPayload"}, {"properties": {"status": {"const": "CLOSED_NO_SELECTION"}, "reason_code": {"type": "null"}, "chosen_invitation_id": {"type": "null"}}}]}}}]},
    "MatchingAttemptInvalidatedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchingAttemptInvalidated"}, "aggregate_type": {"const": "MatchingAttempt"}, "payload": {"allOf": [{"$ref": "#/$defs/AttemptPayload"}, {"properties": {"status": {"const": "INVALIDATED"}, "reason_code": {"$ref": "#/$defs/Code"}, "chosen_invitation_id": {"type": "null"}}}]}}}]},
    "MatchingAttemptCancelledEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchingAttemptCancelled"}, "aggregate_type": {"const": "MatchingAttempt"}, "payload": {"allOf": [{"$ref": "#/$defs/AttemptPayload"}, {"properties": {"status": {"const": "CANCELLED"}, "reason_code": {"$ref": "#/$defs/Code"}, "chosen_invitation_id": {"type": "null"}}}]}}}]},
    "CandidateSelectorAssignedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "CandidateSelectorAssigned"}, "aggregate_type": {"const": "CandidateSelectorAssignment"}, "payload": {"$ref": "#/$defs/CandidateSelectorAssignmentPayload"}}}]},
    "MatchingRulePublishedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchingRulePublished"}, "aggregate_type": {"const": "MatchingRule"}, "payload": {"$ref": "#/$defs/MatchingRulePublishedPayload"}}}]},
    "MatchJobClaimedEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchJobClaimed"}, "aggregate_type": {"const": "MatchJob"}, "payload": {"$ref": "#/$defs/MatchJobClaimedPayload"}}}]},
    "MatchRunRetryScheduledEvent": {"allOf": [{"$ref": "#/$defs/Envelope"}, {"properties": {"event_type": {"const": "MatchRunRetryScheduled"}, "aggregate_type": {"const": "MatchRun"}, "payload": {"$ref": "#/$defs/MatchRunRetryScheduledPayload"}}}]},
