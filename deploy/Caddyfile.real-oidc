{
	admin off
	auto_https disable_redirects
	persist_config off
}

:8080 {
	@edge_health path /_edge/health
	respond @edge_health `{ "status": "LIVE" }` 200
}

https://{$DESIRE_REAL_OIDC_PILOT_HOSTNAME} {
	tls /run/desire-tls/edge-tls-chain.pem /run/secrets/edge-tls-key.pem

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	reverse_proxy web:3000 {
		header_up -Forwarded
		header_up Host {$DESIRE_REAL_OIDC_PILOT_HOSTNAME}
		header_up X-Forwarded-Host {$DESIRE_REAL_OIDC_PILOT_HOSTNAME}
		header_up X-Forwarded-Proto https
	}
}
