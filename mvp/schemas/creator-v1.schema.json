{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desire-supply.local/schemas/creator-v1.schema.json",
  "title": "Desire Supply creator payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "status", "consent_version", "interests",
    "skills", "availability", "collaboration", "compensation", "boundaries",
    "location", "conflicts", "ai"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "status": {"type": "string", "enum": ["active", "paused", "inactive"]},
    "consent_version": {"type": "string", "minLength": 1},
    "interests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_types", "domains", "tasks", "intensity"],
      "properties": {
        "problem_types": {"$ref": "#/$defs/stringArray"},
        "domains": {"$ref": "#/$defs/stringArray"},
        "tasks": {"$ref": "#/$defs/stringArray"},
        "intensity": {"type": "number", "minimum": 0, "maximum": 4}
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "proficiency", "evidence_type", "evidence_trust", "evidence_ref"],
        "properties": {
          "tag": {"type": "string", "minLength": 1},
          "proficiency": {"type": "number", "minimum": 0, "maximum": 4},
          "evidence_type": {"type": "string", "minLength": 1},
          "evidence_trust": {"type": "number", "minimum": 0, "maximum": 4},
          "evidence_ref": {"$ref": "#/$defs/controlledReference"}
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_from", "weekly_hours", "duration_weeks", "timezone"],
      "properties": {
        "available_from": {"$ref": "#/$defs/date"},
        "weekly_hours": {"type": "number", "minimum": 0},
        "duration_weeks": {"type": "number", "minimum": 0},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "work_mode", "feedback_frequency", "team_preference"],
      "properties": {
        "languages": {"$ref": "#/$defs/nonEmptyStringArray"},
        "work_mode": {"type": "string", "minLength": 1},
        "feedback_frequency": {"type": "string", "minLength": 1},
        "team_preference": {"type": "string", "minLength": 1}
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_project", "currency", "direct_cost"],
      "properties": {
        "minimum_project": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "direct_cost": {"type": "number", "minimum": 0}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibited_domains", "prohibited_tasks", "allowed_data_sensitivity"],
      "properties": {
        "prohibited_domains": {"$ref": "#/$defs/stringArray"},
        "prohibited_tasks": {"$ref": "#/$defs/stringArray"},
        "allowed_data_sensitivity": {
          "type": "array",
          "items": {"type": "string", "enum": ["public", "low", "medium", "high", "restricted"]},
          "uniqueItems": true
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region"],
      "properties": {"region": {"type": "string", "minLength": 1}}
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/identifier"},
      "uniqueItems": true
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "requires_ai", "human_review"],
      "properties": {
        "allowed": {"type": "boolean"},
        "requires_ai": {"type": "boolean"},
        "human_review": {"type": "string", "minLength": 1},
        "prohibited_cases": {"$ref": "#/$defs/stringArray"}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^(?=.*[A-Za-z])(?!.*[0-9]{7})[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "controlledReference": {"type": "string", "pattern": "^(?!.*[0-9]{7})(?:external://)?[A-Za-z][A-Za-z0-9_-]{1,127}$"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
